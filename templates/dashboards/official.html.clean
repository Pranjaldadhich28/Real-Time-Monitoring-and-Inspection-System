{% endblock %}

{% block content %}
<script>
    // Enforce role
    Auth.requireRole('official');
    async function loadReports() {
        const res = await Auth.fetchWithAuth('/api/reports/');
        const reports = await res.json();
        const list = document.getElementById('reports-list');
        list.innerHTML = '';
        if(reports.length === 0) return list.innerHTML = '<li class="text-slate-500">No reports.</li>';

        reports.forEach(r => {
            const badges = r.anomaly_set.map(a => `<span class="bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded">⚠️ ${a.type}</span>`).join(' ');
            const status = r.status === 'finalized' ? `<span class="bg-blue-100 text-blue-800 text-[10px] uppercase font-bold px-2 py-1 rounded">Finalized</span>` : `<span class="bg-slate-200 text-slate-600 text-[10px] uppercase font-bold px-2 py-1 rounded">Draft</span>`;
            
            const ev = r.evidence_set?.find(e => e.geo_lat && e.geo_lng);
            const mapBtn = ev ? `<button onclick="openMapModal(${ev.geo_lat}, ${ev.geo_lng})" class="mt-3 text-xs bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-lg border border-indigo-200 hover:bg-indigo-100 font-medium transition shadow-sm">📍 View GPS</button>` : '';

            let details = '';
            if(r.status === 'finalized') {
                details = `
                <div class="mt-3 text-sm grid grid-cols-2 gap-4 bg-slate-50 border border-slate-100 p-3 rounded-lg">
                    <div><span class="text-slate-500 block text-[10px] uppercase font-bold tracking-wider mb-0.5">Beneficiaries</span><span class="font-medium">${r.beneficiaries_verified_count}/${r.beneficiaries_claimed_count}</span></div>
                    <div><span class="text-slate-500 block text-[10px] uppercase font-bold tracking-wider mb-0.5">Funds Verified</span><span class="font-medium">₹${r.fund_utilized_verified||'0'}</span></div>
                </div>`;
            }

            list.innerHTML += `
                <li class="p-5 border border-slate-200 rounded-xl bg-white hover:border-blue-300 transition shadow-sm">
                    <div class="flex justify-between items-start mb-3">
                        <div class="font-bold text-slate-800">Report #${r.id} <span class="text-slate-400 font-normal">| Insp #${r.inspection}</span></div>
                        ${status}
                    </div>
                    <div class="mb-3">${badges}</div>
                    <p class="text-sm text-slate-600 italic leading-snug">"${r.findings || 'No findings.'}"</p>
                    ${details}
                    ${mapBtn}
                </li>
            `;
        });
    }

    async function loadLeavesAndSwaps() {
        const [lRes, sRes] = await Promise.all([Auth.fetchWithAuth('/api/leaves/'), Auth.fetchWithAuth('/api/duty-swaps/')]);
        const leaves = await lRes.json(), swaps = await sRes.json();
        
        const lList = document.getElementById('official-leave-list'); lList.innerHTML='';
        if(leaves.length===0) lList.innerHTML = '<li class="text-slate-500 text-sm">No leave requests.</li>';
        leaves.forEach(l => {
            const acts = l.status === 'pending' ? `<button onclick="Auth.fetchWithAuth('/api/leaves/${l.id}/', {method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'approved'})}).then(loadLeavesAndSwaps)" class="text-[10px] uppercase tracking-wider font-bold bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded transition shadow-sm">Approve</button>` : '';
            lList.innerHTML += `<li class="p-4 border border-slate-200 rounded-xl bg-white flex justify-between items-center hover:shadow-sm transition">
                <div><div class="font-bold text-sm text-slate-800">${l.inspector_name||l.inspector_username}</div><div class="text-xs text-slate-500 mt-0.5 font-medium">${l.start_date} to ${l.end_date}</div></div>
                <div class="flex items-center gap-3"><span class="text-[10px] px-2 py-1 rounded bg-slate-100 uppercase font-bold tracking-wider">${l.status}</span> ${acts}</div>
            </li>`;
        });

        const sList = document.getElementById('official-swap-list'); sList.innerHTML='';
        if(swaps.length===0) sList.innerHTML = '<li class="text-slate-500 text-sm">No swap requests.</li>';
        swaps.forEach(s => {
            const acts = s.status === 'pending' ? `<button onclick="Auth.fetchWithAuth('/api/duty-swaps/${s.id}/', {method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'approved'})}).then(loadLeavesAndSwaps).then(loadInspections)" class="text-[10px] uppercase tracking-wider font-bold bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded transition shadow-sm">Approve</button>` : '';
            sList.innerHTML += `<li class="p-4 border border-slate-200 rounded-xl bg-white hover:shadow-sm transition">
                <div class="flex justify-between items-center mb-2"><span class="font-bold text-sm text-slate-800">Insp #${s.inspection}</span><span class="text-[10px] px-2 py-1 rounded bg-slate-100 uppercase font-bold tracking-wider">${s.status}</span></div>
                <div class="text-xs text-slate-600 bg-slate-50 p-2 rounded border border-slate-100"><span class="line-through text-red-500">${s.original_inspector_name}</span> <span class="mx-1 opacity-50">➔</span> <span class="text-green-600 font-bold">${s.proposed_inspector_name}</span></div>
                <div class="mt-3 text-right">${acts}</div>
            </li>`;
        });
    }

    async function loadInspectorActivity() {
        const res = await Auth.fetchWithAuth('/api/inspector-activity/');
        const logs = await res.json();
        const list = document.getElementById('inspector-activity-list');
        list.innerHTML = '';
        if(logs.length===0) return list.innerHTML = '<tr><td colspan="3" class="px-4 py-6 text-center text-slate-500">No activity logs found.</td></tr>';
        
        logs.slice(0, 15).forEach(l => {
            let actualOnline = l.is_active;
            if (actualOnline && (new Date() - new Date(l.login_time))/(3600000) > 12) actualOnline = false;
            
            const badge = actualOnline ? '<span class="bg-green-100 text-green-800 text-[10px] uppercase px-2 py-0.5 rounded font-bold tracking-wider">Online</span>' : '<span class="bg-slate-100 text-slate-500 text-[10px] uppercase px-2 py-0.5 rounded tracking-wider font-bold">Offline</span>';
            list.innerHTML += `
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-4 py-4 font-medium text-slate-800">${l.inspector_name || l.inspector_username}</td>
                    <td class="px-4 py-4">${badge}</td>
                    <td class="px-4 py-4 text-slate-500 hidden sm:table-cell text-xs">${new Date(l.login_time).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'})}</td>
                </tr>
            `;
        });
    }


    async function loadMissedCalls() {
        try {
            const list = document.getElementById('missed-calls-list');
            if(!list) return;
            const res = await Auth.fetchWithAuth('/api/inspections/missed-calls/');
            if(!res.ok) return;
            const events = await res.json();
            
            list.innerHTML = '';
            if (events.length === 0) {
                list.innerHTML = '<tr><td colspan="5" class="p-4 text-slate-500 text-center">No missed calls recorded.</td></tr>';
                return;
            }
            events.forEach(ev => {
                list.innerHTML += `
                    <tr class="border-b hover:bg-slate-50">
                        <td class="p-3 text-sm">${new Date(ev.created_at).toLocaleString()}</td>
                        <td class="p-3 text-sm font-mono text-slate-500">#${ev.id}</td>
                        <td class="p-3 text-sm font-medium text-slate-900">${ev.inspector_name}</td>
                        <td class="p-3 text-sm text-slate-600">${ev.project_name}</td>
                        <td class="p-3 text-sm font-bold text-red-600 uppercase">Missed</td>
                    </tr>
                `;
            });
        } catch(e) {
            console.error(e);
        }
    }

</script>

<div class="flex h-screen bg-gray-100 overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white flex flex-col hidden md:flex">
        <div class="p-6 border-b border-slate-700">
            <h1 class="text-2xl font-bold tracking-tight text-white">DoSJE</h1>
            <p class="text-slate-400 text-sm mt-1">Official Dashboard</p>
        </div>
        
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            <a href="#" onclick="showSection('dashboard')" class="nav-link block px-4 py-3 rounded bg-blue-600 text-white font-medium transition">📊 Dashboard Overview</a>
            <a href="#" onclick="showSection('scheduling')" class="nav-link block px-4 py-3 rounded text-slate-300 hover:bg-slate-800 hover:text-white transition">🗓️ Schedule Inspection</a>
            <a href="#" onclick="showSection('reports')" class="nav-link block px-4 py-3 rounded text-slate-300 hover:bg-slate-800 hover:text-white transition">📁 Reports Inbox</a>
            <a href="#" onclick="showSection('duplicates')" class="nav-link block px-4 py-3 rounded text-slate-300 hover:bg-slate-800 hover:text-white transition">🔍 Potential Duplicates</a>
            <a href="#" onclick="showSection('missed-calls')" class="nav-link block px-4 py-3 rounded text-slate-300 hover:bg-slate-800 hover:text-white transition">📵 Missed Calls</a>
            <a href="#" onclick="showSection('staff')" class="nav-link block px-4 py-3 rounded text-slate-300 hover:bg-slate-800 hover:text-white transition">👥 Leaves & Swaps</a>
        </nav>
        
        <div class="p-4 border-t border-slate-700">
            <button onclick="Auth.logout()" class="w-full flex items-center justify-center gap-2 px-4 py-2 bg-slate-800 text-slate-300 rounded hover:bg-red-600 hover:text-white transition">
                Logout
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden relative">
        
        <!-- Mobile Header -->
        <header class="md:hidden bg-slate-900 text-white p-4 flex justify-between items-center shadow-md">
            <div class="font-bold text-xl">DoSJE Official</div>
            <button onclick="Auth.logout()" class="text-sm bg-slate-800 px-3 py-1 rounded">Logout</button>
        </header>

        <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-8 pb-24">

            <!-- ===================== SECTION: DASHBOARD ===================== --><!-- ===================== SECTION: DASHBOARD ===================== -->
            <div id="sec-dashboard" class="content-section space-y-8">
                
                <div class="flex justify-between items-end">
                    <div>
                        <h2 class="text-3xl font-bold text-slate-800">Division Overview</h2>
                        <p class="text-slate-500 mt-1">Live metrics and risk analysis for your division.</p>
                    </div>
                    </div>
                </div>

                <!-- KPI Cards Row -->
                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-center items-center">
                        <p class="text-xs text-slate-500 uppercase font-bold text-center">Total NGOs</p>
                        <p class="text-2xl font-bold text-slate-800 mt-1" id="kpi-ngos">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-center items-center">
                        <p class="text-xs text-slate-500 uppercase font-bold text-center">Total Insp.</p>
                        <p class="text-2xl font-bold text-slate-800 mt-1" id="kpi-total-insp">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-center items-center">
                        <p class="text-xs text-slate-500 uppercase font-bold text-center">Pending</p>
                        <p class="text-2xl font-bold text-blue-600 mt-1" id="kpi-pending">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-center items-center">
                        <p class="text-xs text-slate-500 uppercase font-bold text-center">Completed</p>
                        <p class="text-2xl font-bold text-green-600 mt-1" id="kpi-completed">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow border-b-4 border-red-500 flex flex-col justify-center items-center transform scale-105">
                        <p class="text-xs text-slate-500 uppercase font-bold text-center">High Risk</p>
                        <p class="text-3xl font-black text-red-600 mt-1" id="kpi-high-risk">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-center items-center">
                        <p class="text-xs text-slate-500 uppercase font-bold text-center">Needs Review</p>
                        <p class="text-2xl font-bold text-yellow-500 mt-1" id="kpi-review">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-center items-center">
                        <p class="text-xs text-slate-500 uppercase font-bold text-center">Normal</p>
                        <p class="text-2xl font-bold text-emerald-500 mt-1" id="kpi-normal">-</p>
                    </div>
                </div>

                <!-- Charts & Alerts Row -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Chart: Risk Level -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                        <h3 class="font-bold text-slate-700 mb-4">Risk Level Distribution</h3>
                        <div class="relative h-48 w-full">
                            <canvas id="chart-risk"></canvas>
                        </div>
                    </div>
                    <!-- Chart: Inspection Status -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                        <h3 class="font-bold text-slate-700 mb-4">Inspection Status</h3>
                        <div class="relative h-48 w-full flex justify-center">
                            <canvas id="chart-status"></canvas>
                        </div>
                    </div>
                    <!-- Feed: AI Alerts -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col">
                        <h3 class="font-bold text-slate-700 mb-4 flex items-center gap-2">
                            <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                            Recent AI Alerts
                        </h3>
                        <div class="flex-1 overflow-y-auto max-h-48 pr-2 space-y-3" id="ai-alerts-feed">
                            <div class="text-sm text-slate-400 text-center mt-8">Loading alerts...</div>
                        </div>
                    </div>
                </div>

                <!-- Live CCTV Grid & Top Risk Projects -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    
                    <!-- Top Risk Projects -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                        <h3 class="font-bold text-slate-700 mb-4">Top Risk Projects</h3>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm text-left">
                                <thead class="text-xs text-slate-500 uppercase border-b">
                                    <tr>
                                        <th class="py-2">Project</th>
                                        <th class="py-2">NGO</th>
                                        <th class="py-2 text-right">Score</th>
                                    </tr>
                                </thead>
                                <tbody id="top-risk-table">
                                    <tr><td colspan="3" class="py-4 text-center text-slate-400">Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- CCTV Monitoring -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                        <h3 class="font-bold text-slate-700 mb-4 flex items-center justify-between">
                            Live CCTV Monitoring
                            <span class="text-xs font-normal text-slate-500 bg-slate-100 px-2 py-1 rounded" id="cctv-count">0 Active</span>
                        </h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="cctv-grid">
                            <div class="text-sm text-slate-400 col-span-full">Loading feeds...</div>
                        </div>
                    </div>

                </div>
                
                <!-- Active Inspections & Random Verification -->
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 mb-8">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-bold text-slate-700">Scheduled Inspections</h3>
                    </div>
                    <ul id="inspections-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <li class="text-slate-500 text-sm">Loading inspections...</li>
                    </ul>
                </div>

            <!-- ===================== SECTION: SCHEDULING ===================== -->
            <div id="sec-scheduling" class="content-section hidden space-y-8">
                <div class="bg-white shadow p-6 rounded-xl max-w-2xl">
                    <h2 class="text-2xl font-bold mb-6 border-b pb-2">Schedule Inspection</h2>
                    <form id="schedule-form" class="space-y-5">
                        <div>
                            <label class="block font-medium text-slate-700 mb-1">Project</label>
                            <select id="schedule-project" class="w-full border-slate-300 rounded-lg shadow-sm" required>
                                <option value="">Loading projects...</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700 mb-1">Inspector (Optional)</label>
