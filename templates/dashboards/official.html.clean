    async function loadLeavesAndSwaps() {
        const [lRes, sRes] = await Promise.all([Auth.fetchWithAuth('/api/leaves/'), Auth.fetchWithAuth('/api/duty-swaps/')]);
        const leaves = await lRes.json(), swaps = await sRes.json();
        
        const lList = document.getElementById('official-leave-list'); lList.innerHTML='';
        if(leaves.length===0) lList.innerHTML = '<li class="text-slate-500 text-sm">No leave requests.</li>';
        leaves.forEach(l => {
            const acts = l.status === 'pending' ? `<button onclick="Auth.fetchWithAuth('/api/leaves/${l.id}/', {method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'approved'})}).then(loadLeavesAndSwaps)" class="text-[10px] uppercase tracking-wider font-bold bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded transition shadow-sm">Approve</button>` : '';
            lList.innerHTML += `<li class="p-4 border border-slate-200 rounded-xl bg-white flex justify-between items-center hover:shadow-sm transition">
